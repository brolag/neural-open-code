{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 15
  },
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -r *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "chmod 777*": "deny",
      "sudo *": "deny",
      "curl * | bash": "deny",
      "wget * | bash": "deny",
      "curl * | sh": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
